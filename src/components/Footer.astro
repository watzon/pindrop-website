---
import pindropLogo from '../assets/pindrop-logo.svg';

const currentYear = new Date().getFullYear();

const links = [
  { label: 'GitHub', href: 'https://github.com/watzon/pindrop', external: true },
  { label: 'Discussions', href: 'https://github.com/watzon/pindrop/discussions', external: true },
  { label: 'Issues', href: 'https://github.com/watzon/pindrop/issues', external: true },
  { label: 'Contributing', href: 'https://github.com/watzon/pindrop/blob/main/CONTRIBUTING.md', external: true },
  { label: 'Changelog', href: '/changelog' },
];
---

<footer class="mt-32">
  <div class="px-6">
  <div class="max-w-5xl mx-auto">
    <div class="border-t border-[rgba(240,233,225,0.07)] pt-10 pb-8 flex flex-col sm:flex-row sm:items-center gap-6 justify-between">
      <div class="flex items-center gap-3">
        <img src={pindropLogo.src} alt="" width="20" height="20" />
        <p class="text-sm text-ink-3 m-0">
          &copy; {currentYear} Pindrop. Open source under the MIT License.
        </p>
      </div>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Footer">
        {links.map(link => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-sm text-ink-2 hover:text-ink transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <p class="data text-ink-3/60 text-center pb-10 m-0">end of session</p>
  </div>
  </div>
</footer>
