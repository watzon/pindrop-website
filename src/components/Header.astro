---
import Icon from './Icon.astro';
import pindropLogo from '../assets/pindrop-logo.svg';
import { getRepoInfo, getLatestRelease } from '../utils/github';

const navItems = [
  { label: 'Changelog', href: '/changelog' },
  { label: 'Blog', href: '/blog' },
  { label: 'Community', href: '/community' },
];

const [{ stars }, { downloadUrl }] = await Promise.all([getRepoInfo(), getLatestRelease()]);

const starLabel = stars === null
  ? null
  : stars >= 1000
    ? `${(stars / 1000).toFixed(1)}k`
    : String(stars);

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-300
         border-b border-transparent"
>
  <div class="px-6">
  <div class="max-w-5xl mx-auto h-16 flex items-center gap-1">
    <a href="/" class="flex items-center gap-2.5 mr-4 shrink-0">
      <img src={pindropLogo.src} alt="" width="24" height="24" />
      <span class="font-display text-lg text-ink">Pindrop</span>
    </a>

    <nav class="hidden md:flex items-center gap-0.5" aria-label="Main">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`px-3 py-1.5 text-sm rounded-lg transition-colors duration-200 ${
            isActive(item.href)
              ? 'text-ink font-semibold'
              : 'text-ink-2 font-medium hover:text-ink hover:bg-[rgba(240,233,225,0.05)]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-2 ml-auto">
      <a
        href="https://github.com/watzon/pindrop"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-ink-2 hover:text-ink hover:bg-[rgba(240,233,225,0.05)] transition-colors duration-200"
        aria-label="Pindrop on GitHub"
      >
        <Icon name="github" size={15} />
        {starLabel && <span class="data text-xs">{starLabel}</span>}
      </a>
      <a
        href={downloadUrl}
        data-download-trigger={downloadUrl}
        onclick={`event.preventDefault(); window.openDownloadModal('${downloadUrl}')`}
        class="bg-ink text-night text-sm font-semibold px-3.5 py-1.5 rounded-lg hover:bg-[#DCCFC0] transition-colors duration-200"
      >
        Download
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      class="md:hidden ml-auto w-9 h-9 flex flex-col items-center justify-center gap-[5px] rounded-lg hover:bg-[rgba(240,233,225,0.05)] transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="block w-4.5 h-px bg-ink"></span>
      <span class="block w-4.5 h-px bg-ink"></span>
    </button>
  </div>
  </div>
</header>

<!-- Mobile overlay -->
<div
  id="mobile-overlay"
  class="fixed inset-0 z-[60] hidden opacity-0 bg-[rgba(10,10,15,0.97)] backdrop-blur-xl transition-opacity duration-300"
>
  <div class="flex flex-col h-full px-8 pt-28 pb-10">
    <button
      id="mobile-close"
      class="absolute top-4 right-6 w-10 h-10 flex items-center justify-center rounded-lg bg-soot border border-[rgba(240,233,225,0.08)] text-ink-2 hover:text-ink transition-colors"
      aria-label="Close menu"
    >
      <Icon name="x" size={16} />
    </button>

    <nav class="flex flex-col" aria-label="Mobile">
      {navItems.map(item => (
        <a
          href={item.href}
          class="py-4 font-display text-3xl text-ink hover:text-ember-bright transition-colors duration-200 border-b border-[rgba(240,233,225,0.07)]"
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/watzon/pindrop"
        target="_blank"
        rel="noopener noreferrer"
        class="py-4 font-display text-3xl text-ink hover:text-ember-bright transition-colors duration-200 border-b border-[rgba(240,233,225,0.07)] flex items-baseline gap-3"
      >
        GitHub
        {starLabel && <span class="data text-sm text-ink-3">{starLabel} stars</span>}
      </a>
    </nav>

    <div class="mt-auto">
      <a
        href={downloadUrl}
        data-download-trigger={downloadUrl}
        onclick={`event.preventDefault(); window.openDownloadModal('${downloadUrl}')`}
        class="btn-primary w-full justify-center"
      >
        Download for macOS
      </a>
    </div>
  </div>
</div>

<script>
  function setupHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    function onScroll() {
      if (!header) return;
      const scrolled = window.scrollY > 12;
      header.classList.toggle('header-scrolled', scrolled);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const btn = document.getElementById('mobile-menu-btn');
    const overlay = document.getElementById('mobile-overlay');
    const closeBtn = document.getElementById('mobile-close');
    if (!btn || !overlay || !closeBtn) return;

    function openMenu() {
      if (!overlay || !btn) return;
      overlay.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => overlay?.classList.remove('opacity-0'));
    }

    function closeMenu() {
      if (!overlay || !btn) return;
      overlay.classList.add('opacity-0');
      btn.setAttribute('aria-expanded', 'false');
      setTimeout(() => {
        overlay?.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    btn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
    overlay.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  }

  document.addEventListener('astro:page-load', setupHeader);
  setupHeader();
</script>

<style is:global>
  #site-header.header-scrolled {
    background-color: rgba(10, 10, 15, 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-color: rgba(240, 233, 225, 0.06);
  }
</style>
