---
import Icon from './Icon.astro';
---

<div id="download-modal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">

  <!-- Backdrop -->
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-[rgba(6,6,10,0.75)] backdrop-blur-sm transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Panel -->
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div
      id="modal-panel"
      class="relative w-full max-w-md transform transition-all duration-300 scale-95 opacity-0"
    >
      <div class="surface-high relative overflow-hidden rounded-2xl p-8">

        <button
          id="modal-close"
          class="absolute top-4 right-4 p-2 rounded-lg text-ink-3 hover:text-ink hover:bg-[rgba(240,233,225,0.05)] transition-colors"
          aria-label="Close"
        >
          <Icon name="x" size={16} />
        </button>

        <h2 id="modal-title" class="text-2xl text-ink mb-2 pr-8">
          Your download is starting
        </h2>
        <p class="text-sm text-ink-2 leading-relaxed mb-7">
          Open the DMG, drag Pindrop to Applications, and press your hotkey.
          If the download didn't begin, <a id="modal-retry" href="#" class="text-ember-bright hover:text-ink transition-colors underline underline-offset-4 decoration-[rgba(242,181,74,0.35)]">grab it here</a>.
        </p>

        <div class="flex flex-col divide-y divide-[rgba(240,233,225,0.06)] border-y border-[rgba(240,233,225,0.06)]">
          <a
            href="https://github.com/watzon/pindrop"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 py-3.5 text-ink-2 hover:text-ink transition-colors"
          >
            <Icon name="github" size={16} />
            <span class="text-sm font-medium">Star the project on GitHub</span>
            <span class="ml-auto"><Icon name="arrow-up-right" size={13} class="text-ink-3 group-hover:text-ink transition-colors" /></span>
          </a>
          <a
            href="https://github.com/sponsors/watzon"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 py-3.5 text-ink-2 hover:text-ink transition-colors"
          >
            <Icon name="heart" size={16} />
            <span class="text-sm font-medium">Sponsor development</span>
            <span class="ml-auto"><Icon name="arrow-up-right" size={13} class="text-ink-3 group-hover:text-ink transition-colors" /></span>
          </a>
          <a
            href="https://ko-fi.com/watzon"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 py-3.5 text-ink-2 hover:text-ink transition-colors"
          >
            <Icon name="coffee" size={16} />
            <span class="text-sm font-medium">Or leave a tip on Ko-Fi</span>
            <span class="ml-auto"><Icon name="arrow-up-right" size={13} class="text-ink-3 group-hover:text-ink transition-colors" /></span>
          </a>
        </div>

        <button
          id="modal-dismiss"
          class="mt-6 text-sm text-ink-3 hover:text-ink transition-colors"
        >
          Close
        </button>

      </div>
    </div>
  </div>
</div>

<script>
  let lastUrl = '';

  function getEls() {
    return {
      modal:    document.getElementById('download-modal'),
      backdrop: document.getElementById('modal-backdrop'),
      panel:    document.getElementById('modal-panel'),
    };
  }

  function openDownloadModal(url: string) {
    const { modal, backdrop, panel } = getEls();
    if (!modal || !backdrop || !panel) return;

    lastUrl = url;
    const retry = document.getElementById('modal-retry');
    if (retry) retry.setAttribute('href', url);

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      panel.classList.remove('scale-95', 'opacity-0');
      panel.classList.add('scale-100', 'opacity-100');
    });

    const link = document.createElement('a');
    link.href = url;
    link.target = '_blank';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  function closeDownloadModal() {
    const { modal, backdrop, panel } = getEls();
    if (!modal || !backdrop || !panel) return;

    backdrop.classList.add('opacity-0');
    panel.classList.remove('scale-100', 'opacity-100');
    panel.classList.add('scale-95', 'opacity-0');

    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  declare global {
    interface Window { openDownloadModal: (url: string) => void; }
  }
  window.openDownloadModal = openDownloadModal;

  function setupListeners() {
    const modal = document.getElementById('download-modal');
    const closeBtn = document.getElementById('modal-close');
    const dismissBtn = document.getElementById('modal-dismiss');

    if (closeBtn)  closeBtn.onclick  = closeDownloadModal;
    if (dismissBtn) dismissBtn.onclick = closeDownloadModal;
    if (modal) modal.onclick = (e) => { if (e.target === modal) closeDownloadModal(); };
  }

  document.addEventListener('astro:page-load', setupListeners);
  setupListeners();
  document.addEventListener('keydown', (e) => {
    const modal = document.getElementById('download-modal');
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeDownloadModal();
    }
  });
</script>
