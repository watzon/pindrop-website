---
/**
 * The Pindrop Home dashboard, recreated in HTML/CSS with mock data.
 * A faithful screenshot-grade replica of the real app window: presented as
 * an image (role="img"), zero JavaScript, nothing dressed as a live control.
 */

const nav = [
  { icon: 'home', label: 'Home', active: true },
  { icon: 'stats', label: 'Stats' },
  { icon: 'library', label: 'Library', count: '1,284' },
  { icon: 'notes', label: 'Notes' },
  { icon: 'dictionary', label: 'Dictionary' },
  { icon: 'models', label: 'Models' },
];

const stats = [
  { value: '3,204', label: 'Words today' },
  { value: '162', label: 'Words / min' },
  { value: '98', label: 'Sessions' },
  { value: '12-day', label: 'Streak' },
];

const recents = [
  { time: '8:39 PM', text: 'Draft a reply to Maya: happy to move the review to Thursday morning, the deck will be ready by…', dest: 'Mail', dur: '0:11' },
  { time: '8:31 PM', text: 'The latency numbers finally look right on the M2 Air. Batch runs land under two hundred millis…', dest: 'Slack', dur: '0:36' },
  { time: '8:24 PM', text: 'Remind me to renew the domain before Friday.', dest: 'Reminders', dur: '0:05' },
  { time: '7:58 PM', text: 'New paragraph. The changelog page should pull straight from the release notes so nothing drifts…', dest: 'Cursor', dur: '0:52' },
  { time: '7:41 PM', text: 'Grocery list for Sunday: tomatillos, masa, two limes, and whatever looks good at the bakery.', dest: 'Notes', dur: '0:14' },
];

const week = [
  { d: 'S', h: 78, on: false },
  { d: 'M', h: 6, on: false },
  { d: 'T', h: 5, on: false },
  { d: 'W', h: 12, on: true },
  { d: 'T', h: 0, on: false },
  { d: 'F', h: 0, on: false },
  { d: 'S', h: 0, on: false },
];

const months = ['Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'];

// Deterministic pseudo-random heatmap: quiet early months warming toward now.
const HEAT_COLS = 40;
const HEAT_ROWS = 5;
function noise(i: number): number {
  const x = Math.sin(i * 127.1 + 311.7) * 43758.5453;
  return x - Math.floor(x);
}
const heatCells: number[][] = Array.from({ length: HEAT_ROWS }, (_, row) =>
  Array.from({ length: HEAT_COLS }, (_, col) => {
    const ramp = col / (HEAT_COLS - 1);
    const r = noise(row * HEAT_COLS + col);
    const activity = r * (0.12 + ramp * 1.05);
    if (activity < 0.28) return 0;
    if (activity < 0.5) return 1;
    if (activity < 0.75) return 2;
    if (activity < 0.95) return 3;
    return 4;
  })
);
const heatColors = [
  'rgba(240,233,225,0.06)',
  '#4A3A12',
  '#77571A',
  '#C48A1E',
  '#F2B54A',
];
---

<div class="overflow-x-auto -mx-6 px-6">
  <div
    class="app-window mx-auto min-w-[900px] max-w-[1024px] rounded-xl overflow-hidden
           border border-[rgba(240,233,225,0.09)]
           shadow-[0_30px_70px_-20px_rgba(0,0,0,0.8),inset_0_1px_0_rgba(240,233,225,0.05)]
           flex text-left select-none"
    role="img"
    aria-label="The Pindrop Home dashboard: weekly word count, today's stats, recent dictations with playback, a weekly bar chart, and a year-long activity heatmap."
  >
    <!-- Sidebar -->
    <div class="w-[224px] shrink-0 bg-[#101016] border-r border-[rgba(240,233,225,0.06)] px-4 pt-4 pb-5 flex flex-col">
      <div class="flex items-center gap-2 pl-1" aria-hidden="true">
        <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
      </div>

      <span class="font-display text-[1.25rem] text-ink mt-6 mb-5 pl-1">Pindrop</span>

      <div class="flex flex-col gap-0.5">
        {nav.map(item => (
          <span class={`flex items-center gap-2.5 px-3 py-[7px] rounded-lg text-[0.8125rem] ${
            item.active
              ? 'bg-[rgba(240,233,225,0.05)] border border-[rgba(240,233,225,0.08)] text-ink font-semibold'
              : 'text-ink-2 font-medium'
          }`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={item.active ? 'text-ink' : 'text-ink-3'}>
              {item.icon === 'home' && <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1Z" />}
              {item.icon === 'stats' && <path d="M3 17 9 11l4 4 8-8M21 7v4h-4" />}
              {item.icon === 'library' && <path d="M4 4v16M9 4v16M14 5l4.5 15" />}
              {item.icon === 'notes' && <path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1ZM8 9h8M8 13h8M8 17h4" />}
              {item.icon === 'dictionary' && <path d="M5 19.5A2.5 2.5 0 0 1 7.5 17H20V3H7.5A2.5 2.5 0 0 0 5 5.5v14ZM5 19.5A2.5 2.5 0 0 0 7.5 22H20v-5" />}
              {item.icon === 'models' && <path d="m12 2 8 4.5v9L12 20l-8-4.5v-9L12 2ZM12 11 4 6.5M12 11l8-4.5M12 11v9" />}
            </svg>
            {item.label}
            {item.count && <span class="ml-auto font-mono text-[0.6875rem] text-ink-3">{item.count}</span>}
          </span>
        ))}
      </div>

      <div class="mt-auto flex flex-col gap-1">
        <div class="rounded-lg bg-[rgba(242,181,74,0.12)] border border-[rgba(242,181,74,0.18)] px-3 py-2.5 mb-2">
          <span class="flex items-center gap-2 text-[0.8125rem] font-semibold text-ember-bright">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v4" /></svg>
            Ready to dictate
          </span>
          <span class="block font-mono text-[0.6875rem] text-ink-3 mt-1 pl-[21px]">⌥Space</span>
        </div>
        <span class="flex items-center gap-2.5 px-3 py-[7px] text-[0.8125rem] font-medium text-ink-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-ink-3"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1ZM9 4v16M15 10l-2 2 2 2" /></svg>
          Collapse
        </span>
        <span class="flex items-center gap-2.5 px-3 py-[7px] text-[0.8125rem] font-medium text-ink-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-ink-3"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" /></svg>
          Settings
          <span class="ml-auto font-mono text-[0.6875rem] text-ink-3">⌘,</span>
        </span>
      </div>
    </div>

    <!-- Main content -->
    <div class="flex-1 bg-[#0B0B10] px-9 pt-8 pb-8 min-w-0">
      <p class="font-mono text-[0.6875rem] tracking-[0.14em] uppercase text-ink-3 m-0">Wednesday, July 15</p>
      <p class="font-display text-[1.875rem] text-ink leading-snug mt-2 m-0">
        You spoke <em class="display-italic text-ember-bright">42,118 words</em> this week.
      </p>
      <p class="text-[0.8125rem] text-ink-3 mt-1.5 m-0">4 h 12 m of dictation — about 14 h saved over typing it out.</p>

      <!-- Stats row -->
      <div class="flex items-stretch mt-7">
        {stats.map((stat, i) => (
          <div class={`pr-8 ${i > 0 ? 'pl-8 border-l border-[rgba(240,233,225,0.07)]' : ''}`}>
            <span class="block font-mono text-[1.375rem] text-ink leading-none">{stat.value}</span>
            <span class="block font-mono text-[0.625rem] tracking-[0.12em] uppercase text-ink-3 mt-2">{stat.label}</span>
          </div>
        ))}
      </div>

      <!-- Recent -->
      <div class="flex items-center gap-4 mt-9">
        <span class="font-mono text-[0.6875rem] tracking-[0.14em] uppercase text-ink-3">Recent</span>
        <span class="flex-1 h-px bg-[rgba(240,233,225,0.07)]"></span>
        <span class="text-[0.75rem] font-semibold text-ember-bright">Open Library →</span>
      </div>

      <div class="mt-1">
        {recents.map(row => (
          <div class="flex items-center gap-3 py-[9px] border-b border-[rgba(240,233,225,0.05)] last:border-b-0">
            <span class="font-mono text-[0.71875rem] text-ink-3 w-[52px] shrink-0">{row.time}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-3 shrink-0"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v4" /></svg>
            <span class="text-[0.8125rem] text-ink-2 truncate min-w-0">{row.text}</span>
            <span class="ml-auto text-[0.75rem] text-ink-3 shrink-0 whitespace-nowrap">→ {row.dest}</span>
            <span class="flex items-center gap-1.5 border border-[rgba(240,233,225,0.1)] rounded-md px-2 py-[3px] shrink-0">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor" class="text-ink-2"><path d="M7 4.5v15l13-7.5L7 4.5Z" /></svg>
              <span class="font-mono text-[0.6875rem] text-ink-2">{row.dur}</span>
            </span>
          </div>
        ))}
      </div>

      <!-- Bottom panels -->
      <div class="grid grid-cols-[240px_1fr] gap-12 mt-9">
        <!-- This week -->
        <div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[0.6875rem] tracking-[0.14em] uppercase text-ink-3 whitespace-nowrap">This week</span>
            <span class="flex-1 h-px bg-[rgba(240,233,225,0.07)]"></span>
            <span class="font-mono text-[0.71875rem] text-ink-2 whitespace-nowrap">3,204 words</span>
          </div>
          <div class="flex items-end gap-3 h-[72px] mt-5">
            {week.map(day => (
              <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end">
                <span
                  class={`w-full rounded-[4px] ${day.on ? 'bg-ember-bright' : 'bg-[rgba(240,233,225,0.16)]'}`}
                  style={`height: ${Math.max(day.h, 4)}%`}
                ></span>
                <span class={`font-mono text-[0.625rem] ${day.on ? 'text-ember-bright' : 'text-ink-3'}`}>{day.d}</span>
              </div>
            ))}
          </div>
          <span class="block font-mono text-[0.625rem] tracking-[0.14em] uppercase text-ink-3 mt-3">Wednesday</span>
        </div>

        <!-- History heatmap -->
        <div class="min-w-0">
          <div class="flex items-center gap-3">
            <span class="font-mono text-[0.6875rem] tracking-[0.14em] uppercase text-ink-3">History</span>
            <span class="flex-1 h-px bg-[rgba(240,233,225,0.07)]"></span>
            <span class="text-[0.75rem] font-semibold text-ember-bright whitespace-nowrap">Show more stats →</span>
          </div>
          <div class="flex justify-between mt-4 mb-1.5">
            {months.map(m => (
              <span class="font-mono text-[0.625rem] text-ink-3">{m}</span>
            ))}
          </div>
          <div class="flex flex-col gap-[3px]">
            {heatCells.map((row, rowIdx) => (
              <div class="flex gap-[3px]">
                {row.map((cell, colIdx) => {
                  const isLast = rowIdx === 0 && colIdx === HEAT_COLS - 1;
                  return (
                    <span
                      class={`flex-1 aspect-square rounded-[2px] ${isLast ? 'outline outline-1 outline-offset-1 outline-ember-bright' : ''}`}
                      style={`background-color: ${isLast ? '#F2B54A' : heatColors[cell]}`}
                    ></span>
                  );
                })}
              </div>
            ))}
          </div>
          <div class="flex items-center mt-3.5">
            <span class="font-mono text-[0.625rem] tracking-[0.14em] uppercase text-ink-3">Streak</span>
            <span class="font-mono text-[0.6875rem] text-ink-2 ml-2">12-day</span>
            <span class="ml-auto flex gap-[3px]">
              {[0.25, 0.4, 0.55, 0.75, 1].map(opacity => (
                <span class="w-[7px] h-[7px] rounded-[2px] bg-ember-bright" style={`opacity: ${opacity}`}></span>
              ))}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
