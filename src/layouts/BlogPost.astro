---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

interface Props {
  id?: string;
  title: string;
  description: string;
  date: Date;
  version?: string;
  tags?: string[];
}

const { id, title, description, date, version, tags = [] } = Astro.props;

const ogImage = id ? `/og/blog/${id}.png` : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage ?? '/og/home.png', Astro.site).toString();

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  "dateModified": date.toISOString(),
  "url": canonicalURL,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "image": {
    "@type": "ImageObject",
    "url": ogImageUrl,
    "width": 1200,
    "height": 630
  },
  "inLanguage": "en-US",
  ...(tags.length > 0 && { "keywords": tags.join(', ') }),
  "author": {
    "@type": "Organization",
    "name": "Pindrop",
    "url": Astro.site?.toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "Pindrop",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', Astro.site).toString()
    }
  }
};
---

<Layout
  title={`${title} — Pindrop Blog`}
  description={description}
  type="article"
  image={ogImage}
  imageAlt={`Pindrop Blog: ${title}`}
  publishedTime={date}
  tags={tags}
>
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

<Header />

<main class="pt-36 pb-24 px-6">
  <div class="max-w-3xl mx-auto">

    <a
      href="/blog"
      class="btn-quiet text-sm mb-14"
    >
      <Icon name="arrow-right" size={14} class="rotate-180" />
      All posts
    </a>

    <article>

      <header class="mb-14">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-5">
          <time datetime={date.toISOString()} class="data text-ink-3">
            {formattedDate}
          </time>
          {version && (
            <span class="data text-ember-bright">v{version}</span>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl text-ink m-0 leading-[1.1]">
          {title}
        </h1>

        <p class="mt-6 font-display italic text-xl text-ink-3 leading-relaxed m-0">
          {description}
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

    </article>
  </div>
</main>

<Footer />
</Layout>
