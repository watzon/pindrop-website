---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import HeroDictation from '../components/HeroDictation.astro';
import AppWindow from '../components/AppWindow.astro';
import Orb from '../components/Orb.astro';
import { getCollection } from 'astro:content';
import { getLatestRelease } from '../utils/github';

const { version, downloadUrl, dmgSizeMB } = await getLatestRelease();

const releases = (await getCollection('changelog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.version.localeCompare(a.data.version, undefined, { numeric: true }))
  .slice(0, 3);

/** First bold item under "What's New" — the release's own headline. */
function highlightOf(body: string | undefined): string {
  if (!body) return '';
  const m = body.match(/^- \*\*(.+?)\*\*/m);
  if (m) return m[1].replace(/[:.]$/, '');
  const first = body.split('\n').find(l => l.startsWith('- '));
  return first ? first.slice(2).split('.')[0] : '';
}

const engines = [
  { name: 'nemotron', tag: 'Live streaming', detail: 'Powers live dictation: words appear as you speak, with tentative text that settles into place. Prewarmed at launch.' },
  { name: 'whisperkit', tag: 'Whisper on CoreML', detail: 'The accuracy pick for recordings. Every Whisper size up to large-v3 turbo, on the Neural Engine.' },
  { name: 'parakeet', tag: 'NVIDIA Parakeet TDT', detail: 'Near-instant transcription with standout accuracy, via CoreML ports.' },
  { name: 'sensevoice', tag: 'SenseVoice-Small (FunASR)', detail: 'Ultra-fast multilingual recognition with built-in punctuation.' },
  { name: 'apple speech', tag: 'Built into macOS', detail: 'The system recognizer. Nothing extra to download.' },
];

const whileSpeaking = [
  { title: 'One hotkey, any app', detail: 'Toggle or push-to-talk from wherever you\'re typing. There is a cancel hotkey too.' },
  { title: 'Words land live', detail: 'Streaming transcription in the indicator of your choice: the Orb, a pill, a flash under the notch, or a bubble at your caret.' },
  { title: 'Types straight into the field', detail: 'Direct Unicode insertion wherever your cursor is. Dvorak-safe, VM-safe.' },
  { title: 'Knows your vocabulary', detail: 'A custom dictionary with match modes biases recognition toward the terms you actually say.' },
];

const afterStopping = [
  { title: 'A real Library', detail: 'Every dictation is searchable, replayable, editable, and exportable.' },
  { title: 'Meetings and media', detail: 'Transcribe recordings and imported files; diarization labels who said what, and trained voices stay recognized.' },
  { title: 'Optional AI cleanup', detail: 'Polish transcripts with your own API key, or fully locally via Ollama or LM Studio.' },
  { title: 'Notes and stats', detail: 'Spoken notes with checklists, plus streaks, word counts, and trends.' },
];

const ledger = [
  { what: 'Your audio', answer: 'Transcribed on-device, then kept locally or discarded. Retention is your setting, not ours.' },
  { what: 'Your transcripts', answer: 'A SwiftData store in Application Support. Search it, export it, delete it.' },
  { what: 'Telemetry', answer: 'Off. Stays off until you opt in, and never includes transcript content.' },
  { what: 'AI enhancement', answer: 'Optional. Run it locally with Ollama or LM Studio, or bring your own API key.' },
  { what: 'The code', answer: 'All of it, MIT-licensed, on GitHub. Audit the claims yourself.' },
];

const comparison = [
  { feature: 'Pricing',            pindrop: 'Free & Open Source', handy: 'Free (MIT)',          openwhispr: 'Free + $6.67/user/mo Pro',             superwhisper: 'Free + $8.49/mo · $84.99/yr · $249.99 lifetime' },
  { feature: 'Platform',           pindrop: 'macOS 14+',           handy: 'macOS, Windows, Linux', openwhispr: 'macOS 12+, Windows 10+, Linux',       superwhisper: 'macOS, Windows, iOS' },
  { feature: 'App framework',       pindrop: 'Swift / SwiftUI',     handy: 'Rust / Tauri',      openwhispr: 'Electron / React',                    superwhisper: 'Proprietary native apps' },
  { feature: 'ML Engine',          pindrop: '5 local engines',     handy: 'Whisper / Parakeet', openwhispr: 'Whisper / Parakeet / cloud',          superwhisper: 'Whisper / Parakeet / cloud' },
  { feature: 'Transcription Log',  pindrop: true,  handy: true,          openwhispr: true,          superwhisper: true },
  { feature: 'AI Enhancement',     pindrop: true,  handy: 'Experimental', openwhispr: true,          superwhisper: true },
  { feature: 'Custom Vocabulary',  pindrop: true,  handy: true,          openwhispr: true,          superwhisper: true },
  { feature: 'Diarization',        pindrop: true,  handy: false,         openwhispr: 'Business+',   superwhisper: true },
  { feature: 'Media Transcription',pindrop: true,  handy: false,         openwhispr: true,          superwhisper: true },
  { feature: 'Push-to-Talk',       pindrop: true,  handy: true,          openwhispr: true,          superwhisper: true },
  { feature: 'Direct Text Insert', pindrop: true,  handy: 'Clipboard / direct input', openwhispr: true, superwhisper: true },
  { feature: 'Open Source',        pindrop: 'MIT',  handy: 'MIT', openwhispr: 'MIT', superwhisper: false },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pindrop",
  "applicationCategory": "ProductivityApplication",
  "operatingSystem": "macOS",
  "softwareVersion": version,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "downloadUrl": downloadUrl,
  "featureList": "Streaming transcription, Global hotkeys, Speaker diarization, Custom vocabulary, AI enhancement, Transcription library",
  "author": { "@type": "Organization", "name": "Pindrop" }
};

function cell(value: boolean | string, isPindrop: boolean) {
  return { value, isPindrop };
}
---

<Layout title="Pindrop — Mac-Native AI Dictation">
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

<Header />

<main>

  <!-- ─── Hero: a dictation in progress ──────────────────── -->
  <section class="min-h-dvh flex items-center px-6 pt-28 pb-16">
    <div class="max-w-5xl mx-auto w-full">

      <HeroDictation />

      <div class="mt-12">
        <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
          <a
            href={downloadUrl}
            data-download-trigger={downloadUrl}
            onclick={`event.preventDefault(); window.openDownloadModal('${downloadUrl}')`}
            class="btn-primary"
          >
            <Icon name="download" size={17} />
            Download for macOS
          </a>
          <a
            href="https://github.com/watzon/pindrop"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-quiet text-sm"
          >
            <Icon name="github" size={15} />
            View source
          </a>
        </div>
        <p class="data text-ink-3 mt-4 m-0">
          {version}{dmgSizeMB ? ` · ${dmgSizeMB} MB` : ''} · macOS 14+
        </p>
      </div>

    </div>
  </section>


  <!-- ─── Native: why CoreML, not a browser ──────────────── -->
  <section class="px-6 py-28">
    <div class="max-w-5xl mx-auto">
      <p class="font-display text-[clamp(1.75rem,3.6vw,2.75rem)] leading-[1.2] text-ink max-w-3xl m-0">
        Most dictation apps ship a browser pretending to be an app.
        Pindrop is Swift, SwiftUI, and CoreML,
        <em class="display-italic">straight onto the Neural Engine.</em>
      </p>

      <div class="mt-16 flex flex-col divide-y divide-[rgba(240,233,225,0.07)]">
        {[
          ['Neural Engine, not CPU', 'On Apple Silicon, transcription runs on dedicated ML hardware. Cooler, quieter, and kinder to your battery than CPU-bound Whisper ports.'],
          ['Memory-mapped models', 'Models page in from disk instead of squatting on the heap. No sandbox memory ceiling, no GC pauses.'],
          ['A short audio path', 'Microphone to CoreML with no JS, WASM, or Electron in between. Engines prewarm at launch, so first words don\'t wait.'],
        ].map(([title, body]) => (
          <div class="py-7 grid md:grid-cols-[16rem_1fr] gap-2 md:gap-10 md:items-baseline">
            <h2 class="font-body text-base font-semibold text-ink m-0">{title}</h2>
            <p class="text-[0.9375rem] text-ink-2 leading-relaxed m-0 max-w-xl">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── Engines ────────────────────────────────────────── -->
  <section class="px-6 py-28">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-4xl md:text-5xl text-ink m-0">Five engines. Your call.</h2>
      <p class="mt-4 text-ink-2 max-w-[52ch] leading-relaxed">
        All local. Accuracy, latency, languages, or zero setup: pick the
        tradeoff per use, not per subscription tier.
      </p>

      <div class="mt-12 flex flex-col divide-y divide-[rgba(240,233,225,0.07)] border-y border-[rgba(240,233,225,0.07)]">
        {engines.map(engine => (
          <div class="py-6 grid md:grid-cols-[11rem_15rem_1fr] gap-1.5 md:gap-8 items-baseline">
            <span class="data text-ember-bright">{engine.name}</span>
            <span class="text-sm font-medium text-ink">{engine.tag}</span>
            <p class="text-sm text-ink-2 leading-relaxed m-0">{engine.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── While you speak / after you stop ───────────────── -->
  <section id="features" class="px-6 py-28">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-x-16 gap-y-16">

      <div>
        <h2 class="text-3xl md:text-4xl text-ink m-0">While you <em class="display-italic">speak</em></h2>
        <div class="mt-8 flex flex-col divide-y divide-[rgba(240,233,225,0.06)] border-t border-[rgba(240,233,225,0.06)]">
          {whileSpeaking.map(item => (
            <div class="py-5">
              <h3 class="font-body text-[0.9375rem] font-semibold text-ink m-0">{item.title}</h3>
              <p class="text-sm text-ink-2 leading-relaxed m-0 mt-1.5">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-3xl md:text-4xl text-ink m-0">After you <em class="display-italic">stop</em></h2>
        <div class="mt-8 flex flex-col divide-y divide-[rgba(240,233,225,0.06)] border-t border-[rgba(240,233,225,0.06)]">
          {afterStopping.map(item => (
            <div class="py-5">
              <h3 class="font-body text-[0.9375rem] font-semibold text-ink m-0">{item.title}</h3>
              <p class="text-sm text-ink-2 leading-relaxed m-0 mt-1.5">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>


  <!-- ─── The app, as it actually looks ──────────────────── -->
  <section class="px-6 py-28">
    <div class="max-w-5xl mx-auto">
      <AppWindow />
      <p class="data text-ink-3 mt-6 text-center">the Home view · every number on this screen lives on your Mac</p>
    </div>
  </section>


  <!-- ─── The privacy ledger ─────────────────────────────── -->
  <section class="px-6 py-28">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-4xl md:text-5xl text-ink m-0">What leaves your Mac</h2>
      <p class="mt-4 font-display italic text-xl text-ink-3">Short answer: nothing you didn't send yourself.</p>

      <div class="mt-12 flex flex-col divide-y divide-[rgba(240,233,225,0.07)] border-y border-[rgba(240,233,225,0.07)]">
        {ledger.map(row => (
          <div class="py-6 grid md:grid-cols-[13rem_1fr] gap-1.5 md:gap-10 md:items-baseline">
            <span class="text-sm font-medium text-ink-3">{row.what}</span>
            <p class="text-[0.9375rem] text-ink leading-relaxed m-0 max-w-2xl">
              {row.what === 'The code'
                ? <>All of it, MIT-licensed, <a href="https://github.com/watzon/pindrop" target="_blank" rel="noopener noreferrer" class="text-ember-bright hover:text-ink transition-colors underline underline-offset-4 decoration-[rgba(242,181,74,0.35)]">on GitHub</a>. Audit the claims yourself.</>
                : row.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── Comparison ─────────────────────────────────────── -->
  <section id="comparison" class="px-6 py-28">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-4xl md:text-5xl text-ink m-0 mb-12">How it compares</h2>

      <div class="overflow-x-auto -mx-6 px-6">
        <table class="w-full min-w-[800px] text-left border-collapse">
          <thead>
            <tr>
              <th class="py-3.5 pr-4 text-xs font-semibold uppercase tracking-wide text-ink-3 w-[26%] border-b border-[rgba(240,233,225,0.12)]">Feature</th>
              <th class="py-3.5 px-4 text-sm font-semibold text-ink text-center bg-hearth rounded-t-lg border-b border-[rgba(240,233,225,0.12)]">Pindrop</th>
              <th class="py-3.5 px-4 text-sm font-medium text-ink-3 text-center border-b border-[rgba(240,233,225,0.12)]">Handy</th>
              <th class="py-3.5 px-4 text-sm font-medium text-ink-3 text-center border-b border-[rgba(240,233,225,0.12)]">OpenWhispr</th>
              <th class="py-3.5 px-4 text-sm font-medium text-ink-3 text-center border-b border-[rgba(240,233,225,0.12)]">Superwhisper</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row, i) => {
              const isLast = i === comparison.length - 1;
              const rowBorder = isLast ? '' : 'border-b border-[rgba(240,233,225,0.05)]';
              return (
              <tr>
                <td class={`py-3.5 pr-4 text-sm font-medium text-ink-2 ${rowBorder}`}>{row.feature}</td>
                {[cell(row.pindrop, true), cell(row.handy, false), cell(row.openwhispr, false), cell(row.superwhisper, false)].map(({ value, isPindrop }) => (
                  <td class={`py-3.5 px-4 text-center ${rowBorder} ${isPindrop ? `bg-hearth ${isLast ? 'rounded-b-lg' : ''}` : ''}`}>
                    {typeof value === 'boolean' ? (
                      value
                        ? <Icon name="check" size={15} class={`inline ${isPindrop ? 'text-ember-bright' : 'text-ink-3'}`} />
                        : <span class="text-ink-3 opacity-50">—</span>
                    ) : (
                      <span class={`text-[0.8125rem] ${isPindrop ? 'font-semibold text-ink' : 'text-ink-3'}`}>{value}</span>
                    )}
                  </td>
                ))}
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- ─── Fresh from the changelog ───────────────────────── -->
  <section class="px-6 py-28">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-10">
        <h2 class="text-4xl md:text-5xl text-ink m-0">Shipping, steadily</h2>
        <a href="/changelog" class="btn-quiet text-sm">
          Every release
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="flex flex-col divide-y divide-[rgba(240,233,225,0.07)] border-y border-[rgba(240,233,225,0.07)]">
        {releases.map(release => (
          <a
            href={`/changelog#v${release.data.version}`}
            class="group py-6 grid md:grid-cols-[7rem_9rem_1fr] gap-1.5 md:gap-8 items-baseline hover:bg-[rgba(240,233,225,0.02)] transition-colors duration-200 -mx-4 px-4 rounded-lg"
          >
            <span class="data text-ember-bright">v{release.data.version}</span>
            <time datetime={release.data.date.toISOString()} class="data text-ink-3">
              {release.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
            </time>
            <span class="text-[0.9375rem] text-ink-2 group-hover:text-ink transition-colors duration-200 leading-relaxed">
              {highlightOf(release.body)}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── Close: the light source returns ────────────────── -->
  <section class="px-6 pt-28 pb-8">
    <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
      <Orb size={190} />
      <h2 class="mt-10 text-4xl md:text-5xl text-ink m-0 leading-tight">
        So quiet, you can hear a <em class="display-italic text-ember-bright">pin drop</em>.
      </h2>
      <p class="mt-5 text-ink-2 max-w-[46ch] leading-relaxed">
        Your voice, your Mac, your transcripts. Nobody else in the room.
      </p>
      <div class="mt-10 flex flex-col items-center gap-4">
        <a
          href={downloadUrl}
          data-download-trigger={downloadUrl}
          onclick={`event.preventDefault(); window.openDownloadModal('${downloadUrl}')`}
          class="btn-primary"
        >
          <Icon name="download" size={17} />
          Download Pindrop
        </a>
        <span class="data text-ink-3">{version} · free forever · MIT</span>
      </div>
    </div>
  </section>

</main>

<Footer />
</Layout>
