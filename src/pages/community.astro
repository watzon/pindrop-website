---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const resources = [
  {
    title: 'GitHub Repository',
    description: 'Browse the source, open pull requests, and track the roadmap.',
    link: 'https://github.com/watzon/pindrop',
  },
  {
    title: 'Discussions',
    description: 'Ask questions, share setups, and get help from other users.',
    link: 'https://github.com/watzon/pindrop/discussions',
  },
  {
    title: 'Issue Tracker',
    description: 'Found a bug? Report it so it can ship fixed in the next release.',
    link: 'https://github.com/watzon/pindrop/issues',
  },
];

const faqItems = [
  {
    question: 'Does Pindrop work on Intel Macs?',
    answer: 'Yes. Pindrop runs on Intel, but it is tuned for Apple Silicon, where transcription runs on the Neural Engine. On Intel, the smaller models are the comfortable choice.'
  },
  {
    question: 'Is my data sent anywhere?',
    answer: 'Transcription is 100% local; your voice never leaves your Mac. Optional AI enhancement can use external services (Anthropic, OpenAI, OpenRouter) or stay local with Ollama or LM Studio. You decide where anything goes.'
  },
  {
    question: 'What languages are supported?',
    answer: 'The interface speaks more than 30 languages, and you can dictate in dozens more depending on the engine, including Spanish, French, German, Chinese, Russian, Ukrainian, Polish, Hindi, and Malayalam.'
  },
  {
    question: 'How is this different from macOS Dictation?',
    answer: 'macOS Dictation may send audio to Apple\'s servers and offers little control. Pindrop is always offline-first, lets you choose between five local recognition engines, keeps a searchable history, learns your vocabulary, and is fully open source.'
  },
  {
    question: 'Can I contribute?',
    answer: 'Absolutely. Pindrop is MIT-licensed and welcomes bug fixes, features, documentation, and translations. Several recent releases shipped contributor work, from Bluetooth mic fixes to whole new dictation languages.'
  },
];
---

<Layout title="Community & Support — Pindrop" description="Where Pindrop gets built: GitHub, Discussions, and the people dictating in thirty languages.">
  <Header />

  <main class="pt-36 pb-24 px-6">
    <div class="max-w-4xl mx-auto">

      <header class="mb-20">
        <h1 class="text-5xl md:text-6xl text-ink m-0 leading-[1.05]">
          Built in the <em class="display-italic text-ember-bright">open</em>
        </h1>
        <p class="mt-5 text-lg text-ink-2 max-w-[50ch] leading-relaxed">
          Pindrop is one codebase, no company, and a growing set of
          contributors. Get help, report bugs, and shape what ships next.
        </p>
      </header>

      <!-- Resources -->
      <section class="mb-24">
        <div class="flex flex-col divide-y divide-[rgba(240,233,225,0.07)] border-y border-[rgba(240,233,225,0.07)]">
          {resources.map(r => (
            <a
              href={r.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-6 py-7"
            >
              <div>
                <h2 class="font-body text-base font-semibold text-ink m-0 mb-1 group-hover:text-ember-bright transition-colors duration-200">{r.title}</h2>
                <p class="text-sm text-ink-2 m-0">{r.description}</p>
              </div>
              <Icon name="arrow-up-right" size={16} class="shrink-0 text-ink-3 group-hover:text-ink transition-colors duration-200" />
            </a>
          ))}
        </div>
      </section>

      <!-- Contributing -->
      <section class="mb-24">
        <p class="font-display text-[clamp(1.5rem,3vw,2.125rem)] leading-[1.25] text-ink max-w-2xl m-0">
          Recent releases shipped contributor work: new dictation languages,
          Bluetooth microphone fixes, better defaults.
          <em class="display-italic">Yours could be next.</em>
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          <a
            href="https://github.com/watzon/pindrop/blob/main/CONTRIBUTING.md"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-quiet text-sm"
          >
            <Icon name="github" size={15} />
            Contributing guide
            <Icon name="arrow-up-right" size={13} />
          </a>
          <a
            href="https://github.com/watzon/pindrop/blob/main/CODE_OF_CONDUCT.md"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-quiet text-sm"
          >
            Code of conduct
            <Icon name="arrow-up-right" size={13} />
          </a>
        </div>
      </section>

      <!-- FAQ -->
      <section class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl text-ink m-0 mb-8">Common questions</h2>

        <div class="flex flex-col divide-y divide-[rgba(240,233,225,0.07)] border-t border-[rgba(240,233,225,0.07)]">
          {faqItems.map(item => (
            <details class="group">
              <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none select-none">
                <h3 class="font-body font-semibold text-ink text-[0.9375rem] m-0">{item.question}</h3>
                <Icon name="chevron-right" size={15} class="shrink-0 text-ink-3 group-open:rotate-90 transition-transform duration-200" />
              </summary>
              <p class="pb-6 text-sm text-ink-2 leading-relaxed m-0 max-w-[62ch]">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
