---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const title = 'Blog';
const description = 'Longer-form updates from Pindrop: release deep-dives, design notes, and where the project is headed.';
---

<Layout title={`${title} — Pindrop`} description={description}>
  <Header />

  <main class="pt-36 pb-24 px-6">
    <div class="max-w-4xl mx-auto">

      <header class="mb-16">
        <h1 class="text-5xl md:text-6xl text-ink m-0">Blog</h1>
        <p class="mt-5 text-lg text-ink-2 max-w-[52ch] leading-relaxed">
          The longer stories behind the releases. For the play-by-play,
          see the <a href="/changelog" class="text-ember-bright hover:text-ink transition-colors underline underline-offset-4 decoration-[rgba(242,181,74,0.35)]">changelog</a>.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="text-ink-3">Nothing here yet. The first post is being dictated.</p>
      ) : (
        <div class="flex flex-col divide-y divide-[rgba(240,233,225,0.07)] border-y border-[rgba(240,233,225,0.07)]">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} class="group py-9 block">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-3">
                <time datetime={post.data.date.toISOString()} class="data text-ink-3">
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                </time>
                {post.data.version && (
                  <span class="data text-ember-bright">v{post.data.version}</span>
                )}
              </div>
              <h2 class="text-2xl md:text-[1.75rem] text-ink group-hover:text-ember-bright transition-colors duration-200 m-0 leading-snug">
                {post.data.title}
              </h2>
              <p class="mt-3 text-[0.9375rem] text-ink-2 leading-relaxed max-w-2xl m-0">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      )}

    </div>
  </main>

  <Footer />
</Layout>
